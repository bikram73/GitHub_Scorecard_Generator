# GEMINI_API_KEY: Required for Gemini AI API calls & AI reviews.
# Configure this in Netlify Environment Variables (Site settings > Environment variables).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GITHUB_TOKEN (Optional): GitHub Personal Access Token to avoid GitHub API 60 req/hr rate limiting.
# GITHUB_TOKEN="ghp_your_personal_access_token"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
